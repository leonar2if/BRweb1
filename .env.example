# Copia este archivo a ".env" (o ".env.local") y rellena con los datos de TU
# proyecto de Supabase — los mismos que usa la app Android en
# BuildConfig.SUPABASE_URL / SUPABASE_ANON_KEY (buscados vía variables de
# entorno SUPABASE_URL / SUPABASE_ANON_KEY en app/build.gradle.kts).
#
# Puedes reutilizar EXACTAMENTE el mismo proyecto de Supabase que usa la app
# Android: al compartir la misma base de datos, un cliente reservado desde la
# app móvil aparecerá también en la web, y viceversa.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# URL de descarga de la app Android (APK directo o enlace de Google Play).
# Se muestra automáticamente como banner cuando la web detecta que se abre
# desde un dispositivo Android.
VITE_ANDROID_DOWNLOAD_URL=https://play.google.com/store/apps/details?id=com.example
